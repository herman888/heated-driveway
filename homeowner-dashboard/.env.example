# Firmata / Java HTTP server (omit when using Vite dev proxy)
# VITE_FIRMATA_ORIGIN=http://127.0.0.1:8080

# Voice + driveway Q&A via Groq (https://console.groq.com). Copy to `.env.local` and fill in.
VITE_GROQ_API_KEY=

# Optional; default is llama-3.1-8b-instant
# VITE_GROQ_MODEL=llama-3.3-70b-versatile

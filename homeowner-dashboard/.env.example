# Firmata / Java HTTP server (omit when using Vite dev proxy)
# VITE_FIRMATA_ORIGIN=http://127.0.0.1:8080

# Voice + driveway Q&A via Groq (https://console.groq.com).
# Create `.env.local` in this same folder (next to package.json) and paste your keys there — not in this file.
VITE_GROQ_API_KEY=

# Optional; default is llama-3.1-8b-instant
# VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Text-to-speech (https://elevenlabs.io → Profile → API key)
VITE_ELEVENLABS_API_KEY=

# Optional — pick a voice ID from the ElevenLabs “Voices” page (default: Rachel).
# VITE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional TTS model (default: eleven_flash_v2_5)
# VITE_ELEVENLABS_MODEL=eleven_flash_v2_5
